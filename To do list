</style>

<!-- script.js -->
<script>
// Класс Task - представляет одну задачу
class Task {
    constructor(text, priority) {
        this.id = Date.now();
        this.text = text;
        this.priority = priority;
        this.completed = false;
    }

    toggle() {
        this.completed = !this.completed;
    }

    update(text, priority) {
        this.text = text;
        this.priority = priority;
    }
}

// Класс TaskManager - управляет списком задач
class TaskManager {
    constructor() {
        this.tasks = [];
    }

    addTask(text, priority) {
        const task = new Task(text, priority);
        this.tasks.push(task);
        return task;
    }

    getTaskById(id) {
        return this.tasks.find(task => task.id === id);
    }

    deleteTask(id) {
        this.tasks = this.tasks.filter(task => task.id !== id);
    }

    toggleTask(id) {
        const task = this.getTaskById(id);
        if (task) {
            task.toggle();
        }
    }

    updateTask(id, text, priority) {
        const task = this.getTaskById(id);
        if (task) {
            task.update(text, priority);
        }
    }

    clearCompleted() {
        this.tasks = this.tasks.filter(task => !task.completed);
    }

    getFilteredTasks(filter) {
        switch(filter) {
            case 'completed':
                return this.tasks.filter(task => task.completed);
            case 'pending':
                return this.tasks.filter(task => !task.completed);
            case 'high':
            case 'medium':
            case 'low':
                return this.tasks.filter(task => task.priority === filter);
            default:
                return this.tasks;
        }
    }

    getStats() {
        const total = this.tasks.length;
        const completed = this.tasks.filter(task => task.completed).length;
        const pending = total - completed;
        return { total, completed, pending };
    }
}

// Класс UIManager - управляет интерфейсом
class UIManager {
    constructor(taskManager) {
        this.taskManager = taskManager;
        this.currentFilter = 'all';
        this.editingId = null;
        this.priorityIcons = {
            high: '⚠️',
            medium: '➡️',
            low: '⬇️'
        };
        this.initElements();
        this.attachEventListeners();
    }

    initElements() {
        this.taskInput = document.getElementById('taskInput');
        this.prioritySelect = document.getElementById('prioritySelect');
        this.addBtn = document.getElementById('addBtn');
        this.taskList = document.getElementById('taskList');
        this.emptyState = document.getElementById('emptyState');
        this.totalTasks = document.getElementById('totalTasks');
        this.completedTasks = document.getElementById('completedTasks');
        this.pendingTasks = document.getElementById('pendingTasks');
        this.clearBtn = document.getElementById('clearBtn');
        this.filterBtns = document.querySelectorAll('.filter-btn');
    }

    attachEventListeners() {
        this.addBtn.addEventListener('click', () => this.handleAddTask());
        this.taskInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') this.handleAddTask();
        });
        this.clearBtn.addEventListener('click', () => this.handleClearCompleted());
        this.filterBtns.forEach(btn => {
            btn.addEventListener('click', (e) => this.handleFilterChange(e));
        });
    }

    handleAddTask() {
        const text = this.taskInput.value.trim();
        const priority = this.prioritySelect.value;

        if (text === '') {
            alert('Введите текст задачи!');
            return;
        }

        if (this.editingId !== null) {
            this.taskManager.updateTask(this.editingId, text, priority);
            this.editingId = null;
            this.addBtn.textContent = 'Добавить';
        } else {
            this.taskManager.addTask(text, priority);
        }

        this.taskInput.value = '';
        this.render();
    }

    handleToggleTask(id) {
        this.taskManager.toggleTask(id);
        this.render();
    }

    handleDeleteTask(id) {
        this.taskManager.deleteTask(id);
        this.render();
    }

    handleEditTask(id) {
        const task = this.taskManager.getTaskById(id);
        if (task) {
            this.taskInput.value = task.text;
            this.prioritySelect.value = task.priority;
            this.addBtn.textContent = 'Сохранить';
            this.editingId = id;
        }
    }

    handleFilterChange(e) {
        this.currentFilter = e.target.dataset.filter;
        this.filterBtns.forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
        this.render();
    }

    handleClearCompleted() {
        this.taskManager.clearCompleted();
        this.render();
    }

    renderTasks() {
        const filteredTasks = this.taskManager.getFilteredTasks(this.currentFilter);

        if (filteredTasks.length === 0) {
            this.taskList.style.display = 'none';
            this.emptyState.style.display = 'block';
        } else {
            this.taskList.style.display = 'block';
            this.emptyState.style.display = 'none';
        }

        this.taskList.innerHTML = filteredTasks.map(task => `
            <li class="task-item priority-${task.priority} ${task.completed ? 'completed' : ''}">
                <input type="checkbox" class="task-checkbox" 
                       ${task.completed ? 'checked' : ''} 
                       data-id="${task.id}"
                       data-action="toggle">
                <span class="task-priority">${this.priorityIcons[task.priority]}</span>
                <span class="task-text">${task.text}</span>
                <div class="task-actions">
                    <button class="task-btn edit-btn" data-id="${task.id}" data-action="edit">✏️</button>
                    <button class="task-btn delete-btn" data-id="${task.id}" data-action="delete">🗑️</button>
                </div>
            </li>
        `).join('');

        // Добавляем обработчики событий для динамически созданных элементов
        this.taskList.querySelectorAll('[data-action]').forEach(element => {
            element.addEventListener('click', (e) => {
                const id = parseInt(e.target.dataset.id);
                const action = e.target.dataset.action;

                switch(action) {
                    case 'toggle':
                        this.handleToggleTask(id);
                        break;
                    case 'edit':
                        this.handleEditTask(id);
                        break;
                    case 'delete':
                        this.handleDeleteTask(id);
                        break;
                }
            });
        });
    }

    renderStats() {
        const stats = this.taskManager.getStats();
        this.totalTasks.textContent = stats.total;
        this.completedTasks.textContent = stats.completed;
        this.pendingTasks.textContent = stats.pending;
    }

    render() {
        this.renderTasks();
        this.renderStats();
    }
}

// Класс App - главный класс приложения
class App {
    constructor() {
        this.taskManager = new TaskManager();
        this.uiManager = new UIManager(this.taskManager);
        this.init();
    }

    init() {
        this.uiManager.render();
    }
}

// Запуск приложения
const app = new App();
</script>
</body>
</html>
