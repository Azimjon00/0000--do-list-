<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Currency Converter Presentation</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: #0f0f1e;
            overflow: hidden;
        }
        
        .presentation-wrapper {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .slide {
            display: none;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            opacity: 0;
            transition: all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            transform: translateX(100px) scale(0.95);
            overflow-y: auto;
            padding-bottom: 120px;
        }
        
        .slide.active {
            display: flex;
            opacity: 1;
            transform: translateX(0) scale(1);
            z-index: 10;
        }
        
        .slide.prev {
            transform: translateX(-100px) scale(0.95);
        }
        
        .slide-1 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
        }
        
        .slide-1::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            top: -100px;
            right: -100px;
            filter: blur(50px);
        }
        
        .slide-1::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -50px;
            left: -50px;
            filter: blur(50px);
        }
        
        .logo-container {
            position: absolute;
            top: 40px;
            right: 40px;
            z-index: 10;
        }
        
        .logo-container img {
            width: 140px;
            height: 140px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.2);
            padding: 8px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        
        .title-content {
            position: relative;
            z-index: 1;
            animation: slideUp 1s ease-out;
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .title-content h1 {
            font-size: 72px;
            font-weight: 900;
            color: white;
            margin-bottom: 20px;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .title-content p {
            font-size: 28px;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 60px;
            font-weight: 300;
        }
        
        .author-box {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            padding: 40px 60px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }
        
        .author-box p {
            font-size: 20px;
            color: white;
            margin: 12px 0;
            font-weight: 500;
        }
        
        .slide-2, .slide-3, .slide-4, .slide-5, .slide-6 {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            padding: 45px 60px;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
        }
        
        .slide-2 {
            justify-content: center;
        }
        
        .slide-content {
            max-width: 950px;
            width: 100%;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .slide-2 h2, .slide-3 h2, .slide-4 h2, .slide-5 h2, .slide-6 h2 {
            font-size: 48px;
            color: #667eea;
            margin-bottom: 25px;
            font-weight: 800;
            align-self: flex-start;
            width: 100%;
        }
        
        .slide-2 p {
            font-size: 20px;
            color: #e0e0e0;
            margin-bottom: 25px;
            line-height: 1.6;
        }
        
        .slide-3 p, .slide-4 p, .slide-5 p, .slide-6 p {
            font-size: 18px;
            color: #d0d0d0;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 25px;
        }
        
        .feature-item {
            background: rgba(102, 126, 234, 0.1);
            border-left: 4px solid #667eea;
            padding: 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .feature-item:hover {
            background: rgba(102, 126, 234, 0.2);
            transform: translateX(10px);
        }
        
        .feature-item span {
            font-size: 28px;
            margin-right: 12px;
        }
        
        .feature-item p {
            margin: 0;
            font-size: 16px;
            color: #c0c0c0;
        }
        
        .code-block {
            background: #0f0f1e;
            border: 1px solid #667eea;
            border-radius: 12px;
            padding: 20px;
            overflow-x: auto;
            margin: 12px 0;
            font-family: 'Fira Code', 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.7;
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
            box-shadow: 0 0 20px rgba(102, 126, 234, 0.1);
        }
        
        .code-block code {
            display: block;
            white-space: pre;
        }
        
        .code-comment {
            color: #888888;
        }
        
        .code-explanation {
            background: rgba(102, 126, 234, 0.12);
            border-left: 3px solid #667eea;
            padding: 15px 20px;
            margin: 12px 0;
            border-radius: 6px;
            font-size: 15px;
            color: #d0d0d0;
            line-height: 1.6;
        }
        
        .code-explanation strong {
            color: #667eea;
        }
        
        .code-subtitle {
            color: #b0b0b0;
            margin-top: 12px;
            margin-bottom: 10px;
            font-size: 15px;
            font-weight: 500;
        }
        
        .slide-7 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        
        .slide-7 h2 {
            font-size: 64px;
            color: white;
            margin-bottom: 30px;
            font-weight: 900;
        }
        
        .slide-7 p {
            font-size: 22px;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 15px;
            font-weight: 500;
        }
        
        .tech-box {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 30px 50px;
            border-radius: 15px;
            margin-top: 40px;
        }
        
        .tech-box p {
            font-size: 17px;
            margin: 12px 0;
            color: rgba(255, 255, 255, 0.95);
        }
        
        .thank-you {
            font-size: 36px;
            margin-top: 40px;
            font-weight: 700;
            color: white;
        }
        
        .controls {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 30px;
            z-index: 100;
        }
        
        .nav-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }
        
        .nav-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.6);
        }
        
        .nav-btn:active {
            transform: scale(0.95);
        }
        
        .dots {
            display: flex;
            gap: 12px;
        }
        
        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        
        .dot.active {
            background: #667eea;
            width: 30px;
            border-radius: 6px;
            box-shadow: 0 0 20px rgba(102, 126, 234, 0.6);
        }
        
        .dot:hover {
            background: rgba(102, 126, 234, 0.6);
        }
        
        .slide-counter {
            color: #667eea;
            font-weight: 600;
            font-size: 16px;
            min-width: 40px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="presentation-wrapper">
        <!-- Slide 1 -->
        <div class="slide slide-1 active">
            <div class="logo-container">
                <img src="https://alatoo.edu.kg/wp-content/uploads/2023/10/cropped-ALATOO-LOGO-2.png" alt="Alatoo Logo">
            </div>
            <div class="title-content">
                <h1>💱 Currency Converter</h1>
                <p>Real-Time Exchange Rate Calculator</p>
                <div class="author-box">
                    <p>👨‍💻 <strong>Developed by:</strong> Allonbaev Azimjon</p>
                    <p>📚 <strong>Group:</strong> SCA-24B</p>
                    <p>👨‍🏫 <strong>Teacher:</strong> Kubanychek Agai</p>
                </div>
            </div>
        </div>
        
        <!-- Slide 2 -->
        <div class="slide slide-2">
            <div class="slide-content">
                <h2>📋 Обзор проекта</h2>
                <p>Современное веб-приложение для конвертации валют с интуитивным интерфейсом и актуальными курсами обмена</p>
                <div class="features-grid">
                    <div class="feature-item">
                        <span>💱</span>
                        <p><strong>Конвертация</strong> между валютами</p>
                    </div>
                    <div class="feature-item">
                        <span>⚡</span>
                        <p><strong>Real-time</strong> обновление курсов</p>
                    </div>
                    <div class="feature-item">
                        <span>🔄</span>
                        <p><strong>Swap</strong> функция обмена</p>
                    </div>
                    <div class="feature-item">
                        <span>🌍</span>
                        <p><strong>8+ валют</strong> на выбор</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Slide 3 -->
        <div class="slide slide-3">
            <div class="slide-content">
                <h2>🏗️ HTML структура</h2>
                <p class="code-subtitle">Семантичная разметка компонентов приложения</p>
                <div class="code-block"><code><span class="code-comment">// Основной контейнер валюты</span>
&lt;div class="currency-block"&gt;
  &lt;div class="currency-left"&gt;
    &lt;div class="flag"&gt;🇺🇸&lt;/div&gt;
    &lt;select class="currency-code"&gt;
      &lt;option&gt;USD&lt;/option&gt;
      &lt;option&gt;SGD&lt;/option&gt;
      &lt;option&gt;EUR&lt;/option&gt;
    &lt;/select&gt;
  &lt;/div&gt;
  &lt;input type="number" 
         class="amount-input" 
         placeholder="0"&gt;
&lt;/div&gt;

<span class="code-comment">// Кнопка для обмена валют</span>
&lt;button class="swap-btn"&gt;⇅&lt;/button&gt;</code></div>
                <div class="code-explanation">
                    <strong>📌 Ключевые моменты:</strong> HTML использует семантичные элементы с четкими именами классов. Элемент select позволяет выбирать из поддерживаемых валют, а поле input принимает сумму для конвертации.
                </div>
            </div>
        </div>
        
        <!-- Slide 4 -->
        <div class="slide slide-4">
            <div class="slide-content">
                <h2>🎨 CSS стили</h2>
                <p class="code-subtitle">Современный дизайн с анимациями и градиентами</p>
                <div class="code-block"><code><span class="code-comment">/* Главный контейнер с тенью */</span>
.container {
  width: 100%;
  max-width: 375px;
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

<span class="code-comment">/* Кнопка свапа с эффектом наведения */</span>
.swap-btn {
  width: 48px;
  height: 48px;
  background: #0066ff;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  transition: transform 0.2s ease;
  box-shadow: 0 4px 12px rgba(0, 102, 255, 0.3);
}

.swap-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 16px rgba(0, 102, 255, 0.4);
}</code></div>
                <div class="code-explanation">
                    <strong>✨ Особенности дизайна:</strong> Плавные переходы делают интерфейс отзывчивым. Кнопка свапа увеличивается при наведении, обеспечивая визуальную обратную связь. Border-radius создает скругленные углы для современного вида.
                </div>
            </div>
        </div>
        
        <!-- Slide 5 -->
        <div class="slide slide-5">
            <div class="slide-content">
                <h2>⚙️ JavaScript функциональность</h2>
                <p class="code-subtitle">Обработка событий и интерактивные функции</p>
                <div class="code-block"><code><span class="code-comment">// Обмен валют по клику на кнопку</span>
$('swap-btn').addEventListener('click', () => {
  [fromCurrency, toCurrency] = 
    [toCurrency, fromCurrency];
  $('from-select').value = fromCurrency;
  $('to-select').value = toCurrency;
  updateFlags();
  calculate();
});

<span class="code-comment">// Автоматический расчет при вводе</span>
$('amount-input')
  .addEventListener('input', calculate);

<span class="code-comment">// Получение актуальных курсов</span>
$('to-select').addEventListener('change', e => {
  toCurrency = e.target.value;
  updateFlags();
  calculate();
});</code></div>
                <div class="code-explanation">
                    <strong>🎯 Объяснение логики:</strong> Функция обмена использует деструктуризацию массива для эффективного обмена значений. Event listeners срабатывают для расчета моментально при вводе пользователя. Функция updateFlags() обновляет иконки флагов валют.
                </div>
            </div>
        </div>
        
        <!-- Slide 6 -->
        <div class="slide slide-6">
            <div class="slide-content">
                <h2>🌟 Ключевые возможности</h2>
                <p class="code-subtitle">Функциональные особенности приложения</p>
                <div class="code-block"><code><span class="code-comment">// Получение и кэширование курсов валют</span>
async function fetchRates() {
  try {
    const response = await fetch(API_URL);
    const data = await response.json();
    rates = data.rates;
    updateDisplay();
  } catch (error) {
    console.error('Error fetching rates:', error);
  }
}

<span class="code-comment">// Основной расчет конвертации</span>
function calculate() {
  const amount = $('amount-input').value;
  const rate = rates[fromCurrency][toCurrency];
  const result = amount * rate;
  $('result-text').textContent = result.toFixed(2);
}</code></div>
                <div class="code-explanation">
                    <strong>💡 Функциональность:</strong> fetchRates() получает последние курсы с API и кэширует их для быстрого доступа. Функция calculate() выполняет математическую конвертацию и обновляет результат в реальном времени. Используется async/await для асинхронных операций.
                </div>
            </div>
        </div>
        
        <!-- Slide 7 -->
        <div class="slide slide-7">
            <h2>✅ Заключение</h2>
            <p>Успешно разработано полнофункциональное веб-приложение</p>
            <p>для конвертации валют с современным дизайном</p>
            <div class="tech-box">
                <p>🔧 <strong>Технологии:</strong> HTML5 • CSS3 • JavaScript ES6+</p>
                <p>💻 <strong>Платформа:</strong> Web (Responsive Design)</p>
                <p>⚡ <strong>Функциональность:</strong> Real-time Currency Conversion с API интеграцией</p>
                <p>🎨 <strong>Дизайн:</strong> Современный и пользовательский интерфейс</p>
            </div>
            <div class="thank-you">Спасибо за внимание! 🙏</div>
        </div>
    </div>
    
    <div class="controls">
        <button class="nav-btn" onclick="previousSlide()">❮</button>
        <div class="dots" id="dots-container"></div>
        <span class="slide-counter"><span id="current">1</span>/7</span>
        <button class="nav-btn" onclick="nextSlide()">❯</button>
    </div>
    
    <script>
        let currentSlide = 1;
        const totalSlides = 7;
        
        const dotsContainer = document.getElementById('dots-container');
        for (let i = 1; i <= totalSlides; i++) {
            const dot = document.createElement('div');
            dot.className = 'dot' + (i === 1 ? ' active' : '');
            dot.onclick = () => goToSlide(i);
            dotsContainer.appendChild(dot);
        }
        
        function showSlide(n) {
            const slides = document.querySelectorAll('.slide');
            
            slides.forEach((slide, index) => {
                slide.classList.remove('active', 'prev');
                if (index + 1 === n) {
                    slide.classList.add('active');
                } else if (index + 1 < n) {
                    slide.classList.add('prev');
                }
            });
            
            document.querySelectorAll('.dot').forEach((dot, index) => {
                dot.classList.toggle('active', index + 1 === n);
            });
            
            document.getElementById('current').textContent = n;
        }
        
        function nextSlide() {
            currentSlide++;
            if (currentSlide > totalSlides) currentSlide = totalSlides;
            showSlide(currentSlide);
        }
        
        function previousSlide() {
            currentSlide--;
            if (currentSlide < 1) currentSlide = 1;
            showSlide(currentSlide);
        }
        
        function goToSlide(n) {
            currentSlide = n;
            showSlide(currentSlide);
        }
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') nextSlide();
            if (e.key === 'ArrowLeft') previousSlide();
        });
        
        showSlide(currentSlide);
    </script>
</body>
