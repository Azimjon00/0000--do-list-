<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Презентация: Конвертер валют</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0e27;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      width: 200%;
      height: 200%;
      background: 
        radial-gradient(circle at 20% 50%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(255, 121, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 20%, rgba(138, 201, 255, 0.3) 0%, transparent 50%);
      animation: float 20s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(30px, -30px) rotate(120deg); }
      66% { transform: translate(-20px, 20px) rotate(240deg); }
    }

    .presentation {
      width: 90vw;
      max-width: 1200px;
      height: 90vh;
      max-height: 675px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 30px;
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      position: relative;
      overflow: hidden;
    }

    .presentation::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(
        from 0deg at 50% 50%,
        rgba(138, 201, 255, 0.1) 0deg,
        rgba(255, 121, 198, 0.1) 120deg,
        rgba(120, 119, 198, 0.1) 240deg,
        rgba(138, 201, 255, 0.1) 360deg
      );
      animation: rotate 20s linear infinite;
      pointer-events: none;
    }

    @keyframes rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .slide {
      position: absolute;
      width: 100%;
      height: 100%;
      padding: 60px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      transform: translateX(100%);
      transition: all 0.5s ease;
    }

    .slide.active {
      opacity: 1;
      transform: translateX(0);
    }

    .slide.prev {
      transform: translateX(-100%);
    }

    .slide h1 {
      font-size: 56px;
      color: #ffffff;
      margin-bottom: 20px;
      font-weight: 800;
      text-shadow: 0 0 30px rgba(138, 201, 255, 0.5);
    }

    .slide h2 {
      font-size: 42px;
      background: linear-gradient(135deg, #8ac9ff 0%, #ff79c6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 30px;
      font-weight: 700;
    }

    .slide p {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.6;
      margin-bottom: 15px;
    }

    .slide ul {
      list-style: none;
      padding-left: 0;
    }

    .slide li {
      font-size: 22px;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 20px;
      padding-left: 40px;
      position: relative;
      line-height: 1.5;
    }

    .slide li:before {
      content: "✓";
      position: absolute;
      left: 0;
      background: linear-gradient(135deg, #8ac9ff 0%, #ff79c6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: bold;
      font-size: 28px;
    }

    .title-slide {
      background: transparent;
      color: white;
      align-items: center;
      text-align: center;
    }

    .title-slide h1 {
      color: white;
      font-size: 64px;
      animation: glow 2s ease-in-out infinite;
    }

    @keyframes glow {
      0%, 100% {
text-shad
100% { text-shadow: 0 0 20px rgba(138, 201, 255, 0.5), 0 0 40px rgba(138, 201, 255, 0.3); }
      50% { text-shadow: 0 0 30px rgba(255, 121, 198, 0.6), 0 0 60px rgba(255, 121, 198, 0.4); }
    }

    .title-slide p {
      color: rgba(255, 255, 255, 0.9);
      font-size: 24px;
    }

    .author {
      margin-top: 40px;
      font-size: 20px;
      color: rgba(138, 201, 255, 0.9);
      font-weight: 600;
      letter-spacing: 1px;
    }

    .emoji {
      font-size: 80px;
      margin-bottom: 20px;
      filter: drop-shadow(0 0 20px rgba(138, 201, 255, 0.5));
      animation: float-emoji 3s ease-in-out infinite;
    }

    @keyframes float-emoji {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    .controls {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 20px;
      z-index: 100;
    }

    button {
      padding: 12px 24px;
      font-size: 16px;
      border: none;
      background: linear-gradient(135deg, #8ac9ff 0%, #ff79c6 100%);
      color: white;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(138, 201, 255, 0.4);
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(255, 121, 198, 0.6);
    }

    button:disabled {
      background: rgba(255, 255, 255, 0.1);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .slide-counter {
      position: absolute;
      top: 30px;
      right: 30px;
      font-size: 18px;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 600;
      z-index: 10;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 20px;
    }

    .feature-box {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(138, 201, 255, 0.2);
      padding: 20px;
      border-radius: 16px;
      border-left: 4px solid;
      border-image: linear-gradient(180deg, #8ac9ff, #ff79c6) 1;
      transition: all 0.3s ease;
    }

    .feature-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(138, 201, 255, 0.3);
    }

    .feature-box h3 {
      background: linear-gradient(135deg, #8ac9ff 0%, #ff79c6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 10px;
      font-size: 20px;
    }

    .feature-box p {
      font-size: 16px;
      margin: 0;
      color: rgba(255, 255, 255, 0.8);
    }

    .tech-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-top: 30px;
    }

    .tech-item {
      background: rgba(138, 201, 255, 0.1);
      border: 2px solid rgba(138, 201, 255, 0.3);
      border-radius: 16px;
      padding: 25px;
      transition: all 0.3s ease;
    }

    .tech-item:hover {
      background: rgba(138, 201, 255, 0.15);
      border-color: rgba(138, 201, 255, 0.5);
      transform: scale(1.02);
    }

    .tech-item h3 {
      font-size: 24px;
      background: linear-gradient(135deg, #8ac9ff 0%, #ff79c6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 12px;
    }

    .tech-item p {
      font-size: 18px;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.5;
    }
  </style>
</head>
